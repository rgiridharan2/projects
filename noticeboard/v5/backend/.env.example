# Copy to .env only if you need different values; these are the defaults.
DATABASE_URL=postgresql+psycopg://noticeboard:noticeboard@localhost:5437/noticeboard
TEST_DATABASE_URL=postgresql+psycopg://noticeboard:noticeboard@localhost:5437/noticeboard_test

# Signs the JWTs. Anyone with this value can forge a login, so set a long random one outside local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_MINUTES=480
